% ----------------
% Beamer Theme Color Layout
% ----------------
% 基本颜色设置.
\setbeamercolor{structure}{fg=PrimaryC}
\setbeamercolor{background canvas}{bg=BackgroundC}

% 调色板颜色设置.
\setbeamercolor{palette primary}   {fg=white, bg=PrimaryC}
\setbeamercolor{palette secondary} {fg=NormalTextC, bg=BackgroundC}
\setbeamercolor{palette tertiary}  {fg=AlertedTextC, bg=BackgroundC}
\setbeamercolor{palette quaternary}{fg=AuxiliaryC, bg=BackgroundC}

% 页眉页脚颜色设置.
\setbeamercolor{section in head/foot}    {fg=white, bg=PrimaryC}
% 左侧小节导航位于白色背景，不能继承右侧章节栏的白色前景。
\setbeamercolor{subsection in head/foot} {fg=PrimaryC, bg=BackgroundC}
\setbeamercolor{mini frame}             {fg=PrimaryC, bg=BackgroundC}
\setbeamercolor{frametitle}              {fg=PrimaryC}
\setbeamercolor{framesubtitle}           {fg=AuxiliaryC}
\setbeamercolor{author in head/foot}     {fg=MutedTextC, bg=BackgroundC}
\setbeamercolor{title in head/foot}      {fg=MutedTextC, bg=BackgroundC}
\setbeamercolor{framenumber in head/foot}{fg=PrimaryC, bg=BackgroundC}

% 封面颜色设置.
\setbeamercolor{title}          {bg=BackgroundC, fg=PrimaryC}
\setbeamercolor{subtitle}       {bg=BackgroundC, fg=AuxiliaryC}
\setbeamercolor{author}         {bg=BackgroundC, fg=MutedTextC}
\setbeamercolor{date}           {bg=BackgroundC, fg=MutedTextC}
\setbeamercolor{titlepageheader}{bg=BackgroundC, fg=MutedTextC}
\setbeamercolor{titlepagefooter}{bg=BackgroundC, fg=MutedTextC}

% 标准 Beamer 区块颜色：标题与正文共享纯白内容区.
\setbeamercolor*{block title}        {fg=PrimaryC, bg=BlockNormalBgC}
\setbeamercolor*{block body}         {fg=NormalTextC, bg=BlockNormalBgC}
\setbeamercolor*{block title example}{fg=AuxiliaryC, bg=BlockNormalBgC}
\setbeamercolor*{block body example} {fg=NormalTextC, bg=BlockNormalBgC}
\setbeamercolor*{block title alerted}{fg=PrimaryC, bg=BlockWarmBgC}
\setbeamercolor*{block body alerted} {fg=NormalTextC, bg=BlockWarmBgC}

% 列表和正文颜色设置.
\setbeamercolor{item}                {fg=PrimaryC}
\setbeamercolor{item projected}      {fg=white, bg=PrimaryC}
\setbeamercolor{enumerate item}      {fg=PrimaryC}
\setbeamercolor{enumerate subitem}   {fg=PrimaryC}
\setbeamercolor{enumerate subsubitem}{fg=PrimaryC}
\setbeamercolor*{normal text}        {fg=NormalTextC, bg=BackgroundC}
\setbeamercolor*{alerted text}       {fg=AlertedTextC}

% 普通 booktabs 边界线默认采用主题深蓝；表头分界线由主题命令切换为浅蓝.
\arrayrulecolor{TableRuleC}
