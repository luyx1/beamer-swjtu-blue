\newlength{\academictablebodyrulewidth}
\setlength{\academictableouterrulewidth}{\academicdim{0.9pt}}% 顶部与底部规则.
\setlength{\academictableheadrulewidth}{\academicdim{0.5pt}}% 表头分界规则.
\setlength{\academictablebodyrulewidth}{\academicdim{0.35pt}}% 正文行分隔线.
\setlength{\heavyrulewidth}{\academictableouterrulewidth}
\setlength{\lightrulewidth}{\academictableheadrulewidth}
\setlength{\cmidrulewidth}{\academictableheadrulewidth}
\setlength{\aboverulesep}{0.45ex}% 规则线上留白.
\setlength{\belowrulesep}{0.45ex}% 规则线下留白.
\newif\ifbeamer@academic@table@striping
\newcommand{\academictablebegin}{\beamer@academic@table@stripingtrue}% 标记下一张表启用隔行底纹.
\newcommand{\academictableend}{%
  \beamer@academic@table@stripingfalse
  \global\@rowcolorsfalse
  \global\let\CT@row@color\relax
}
\newcommand{\academictableapplyrowcolors}{\rowcolors{1}{TableStripeC}{TableBodyC}}
\newcommand{\academictabletoprule}{\arrayrulecolor{TableRuleC}\toprule}
\newcommand{\academictableheadrule}{%
  \arrayrulecolor{TableHeaderRuleC}%
  \specialrule{\academictableheadrulewidth}{\aboverulesep}{\belowrulesep}%
}
\newcommand{\academictablebodyrule}{%
  \arrayrulecolor{TableRowRuleC}%
  \specialrule{\academictablebodyrulewidth}{\aboverulesep}{\belowrulesep}%
}
\newcommand{\academictablebottomrule}{\arrayrulecolor{TableRuleC}\bottomrule}
\newcommand{\academictableheaderrowcolors}{%
  \gdef\@oddrowcolor{\gdef\CT@row@color{\CT@color{TableBodyC}}}%
  \gdef\@evenrowcolor{\gdef\CT@row@color{\CT@color{TableStripeC}}}%
}
\newcommand{\academictableheader}[1]{%
  \academictableheaderrowcolors
  \cellcolor{TableHeaderC}\textcolor{TableHeaderTextC}{\bfseries #1}%
}
\AtBeginEnvironment{tabular}{%
  \ifbeamer@academic@table@striping
