\def\beamer@academic@PPTBulletType{dot}

\newcommand{\PPTDot}{%
  \tikz[baseline=-0.45ex,inner sep=0pt,outer sep=0pt]{%
    \fill[PPTBulletBlue] (0,0) circle (\academicdim{1.5pt});%
  }%
}
\newcommand{\PPTSquare}{%
  \tikz[baseline=-0.45ex,inner sep=0pt,outer sep=0pt]{%
    \fill[PPTBulletBlue] (-\academicdim{2.4pt},-\academicdim{2.4pt}) rectangle (\academicdim{2.4pt},\academicdim{2.4pt});%
  }%
}
\newcommand{\PPTDiamond}{%
  \tikz[baseline=-0.45ex,inner sep=0pt,outer sep=0pt]{%
    \fill[PPTBulletBlue] (0,\academicdim{3pt}) -- (\academicdim{3pt},0) -- (0,-\academicdim{3pt}) -- (-\academicdim{3pt},0) -- cycle;%
  }%
}
\newcommand{\PPTTriangle}{%
  \tikz[baseline=-0.45ex,inner sep=0pt,outer sep=0pt]{%
    \fill[PPTBulletBlue] (0,\academicdim{2.8pt}) -- (\academicdim{2.8pt},-\academicdim{2pt}) -- (-\academicdim{2.8pt},-\academicdim{2pt}) -- cycle;%
  }%
}
\newcommand{\PPTBulletSymbol}[1]{%
  \ifstrequal{#1}{square}{\PPTSquare}{%
    \ifstrequal{#1}{diamond}{\PPTDiamond}{%
      \ifstrequal{#1}{triangle}{\PPTTriangle}{\PPTDot}%
    }%
  }%
}
\newcommand{\beamer@academic@listsubbullet}{%
  \tikz[baseline=-0.45ex,inner sep=0pt,outer sep=0pt]{%
    \fill[PPTBulletBlue] (0,0) circle (\academicdim{1.1pt});%
  }%
}
\newcommand{\beamer@academic@listthirdbullet}{%
