% Resolve bundled assets from the theme directory, not the caller's cwd.
% The .fls recorder gives the physical path even when kpathsea hides it from
% \CurrentFilePath. For unusual installs, \AcademicThemePath remains an override.
\providecommand{\AcademicThemePath}{}
\ifx\AcademicThemePath\@empty
  \def\academicthemedir{}
  \RequirePackage{currfile-abspath}
  \IfFileExists{\jobname.fls}{%
    \getabspath{beamerthemeacademic.sty}%
    \edef\academicthemedir{\theabsdir}%
  }{}
  \ifx\academicthemedir\@empty
    \ifdefined\CurrentFilePath
      \edef\academic@currentfilepath{\CurrentFilePath}
      \ifx\academic@currentfilepath\@empty
        \def\academicthemedir{./}
      \else
        \edef\academicthemedir{\academic@currentfilepath/}
      \fi
    \else
      \def\academicthemedir{./}
    \fi
  \fi
\else
  \edef\academicthemedir{\AcademicThemePath/}
\fi
\edef\academicfontpath{\academicthemedir fonts/}
\edef\academicresourcepath{\academicthemedir resources/}
