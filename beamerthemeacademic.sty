% Automatic Frame Layout
% Confirmed in v1.3b(2022/04/13).
% Established in v1.0a(2021/12/03).
% Updated in v1.1a(2021/12/30).
% ----------------
% 以下设置自动帧输出, 含封页, 大章前目录页.
% ----------------
% 添加封页.
\AtBeginDocument{%
  \begingroup%
    % 取消页眉残留空白.
    \vspace*{-\dimexpr\headheight+\topskip\relax}%
    \begin{frame}[plain]
      %\transfade 渐变
      \titlepage% 显示 titlepage.
    \end{frame}
  \endgroup%
}

% 大章对应 Beamer section；小节 subsection 不生成分隔页。
\def\inserttableofcontent{%
  \ifbeamer@academic@contentmuticols%
    \begin{multicols}{2}
      \tableofcontents[currentsection,hideallsubsections]%
    \end{multicols}
  \else%
    \tableofcontents[currentsection,hideallsubsections]%
  \fi%
}
\if\EqualOptionsBeamer{SectionTOC}{show}%
\AtBeginSection[]{%
  \begingroup%
    \if\EqualOptionsBeamer{LanguageMode}{cn}
      \begin{frame}{目录}
        \inserttableofcontent%
      \end{frame}
    \else\if\EqualOptionsBeamer{LanguageMode}{en}
      \begin{frame}{Outline}
        \inserttableofcontent%
      \end{frame}
    \fi\fi
  \endgroup%
}
\fi
