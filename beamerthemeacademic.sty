  }%
}

% 兼容旧的主题级选择命令；新文档优先使用 PPTList[dot|square|diamond|triangle]。
\newcommand{\academicsetbullet}[1]{%
  \ifstrequal{#1}{circle}{%
    \def\beamer@academic@PPTBulletType{dot}%
  }{%
    \def\beamer@academic@PPTBulletType{#1}%
  }%
}
\newenvironment{PPTList}[1][dot]{%
  \begingroup
  \setbeamertemplate{itemize item}{\PPTBulletSymbol{#1}}%
  \begin{itemize}
    \setlength{\itemsep}{0.35em}%
    \setlength{\topsep}{0.2em}%
    \setlength{\parsep}{0pt}%
}{%
  \end{itemize}%
  \endgroup
}

\ExplSyntaxOn
\cs_new_protected:Npn \beamer@academic@researchcard@setdisplaynumber #1
  {
    \cs_set:Npn \beamer@academic@researchcard@displaynumber {}
    \beamer@academic@researchcard@hasdisplaynumberfalse
    \regex_match:nnTF { \A [0-9]+ \Z } {#1}
      {
        \int_compare:nNnT {#1} > {0}
          {
            \cs_set:Npx \beamer@academic@researchcard@displaynumber { \int_eval:n {#1} }
            \beamer@academic@researchcard@hasdisplaynumbertrue
          }
      }
      { }
  }
\cs_new_protected:Npn \beamer@academic@researchcard@prepare #1
  {
    \cs_set:Npn \beamer@academic@researchcard@displaynumber {}
    \cs_set:Npn \beamer@academic@researchcard@academicnumber {}
    \cs_set:Npn \beamer@academic@researchcard@options {}
    \beamer@academic@researchcard@hasdisplaynumberfalse
    \tl_if_blank:nF {#1}
      {
        \regex_match:nnTF { \A [0-9]+ \Z } {#1}
          { \beamer@academic@researchcard@setdisplaynumber {#1} }
          {
            \regex_match:nnTF { \A [-+]? [0-9]+ \. [0-9]+ \Z } {#1}
              { \cs_set:Npn \beamer@academic@researchcard@academicnumber {#1} }
              {
                \regex_match:nnTF { \A [-+]? [0-9]+ \Z } {#1}
                  { }
                  { \cs_set:Npn \beamer@academic@researchcard@options {#1} }
              }
          }
      }
  }
\ExplSyntaxOff
\tcbset{display number/.code={\beamer@academic@researchcard@setdisplaynumber{#1}}}

