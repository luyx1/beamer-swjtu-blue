% 调整左右边距.
\setbeamersize{text margin left=0.03\paperwidth, text margin right=0.03\paperwidth}% 0.036, 0.036
% 设置目录深度为 2 (显示至 subsection).
\setcounter{tocdepth}{2}
\setbeamersize{mini frame size=\academicdim{.14cm},mini frame offset=-\academicdim{.01cm}}
\tikzset{thin/.style={line width=\academicdim{.4pt}},
  semithick/.style={line width=\academicdim{.6pt}},thick/.style={line width=\academicdim{.8pt}},
  very thick/.style={line width=\academicdim{1.2pt}},ultra thick/.style={line width=\academicdim{1.6pt}}}
% PGFPlots reserves a fixed 45pt for labels when sizing an axis. Scale that
% reservation along with the labels, so plots still fit their column widths.
\AddToHook{package/pgfplots/after}{%
  \patchcmd{\pgfplots@initsizes@get@width@withoutlabels}
    {45pt}{\academicdim{45pt}}{}{
      \PackageWarning{beamerthemeacademic}{Could not scale PGFPlots width reservation}}%
  \patchcmd{\pgfplots@initsizes@get@height@withoutlabels}
    {45pt}{\academicdim{45pt}}{}{
      \PackageWarning{beamerthemeacademic}{Could not scale PGFPlots height reservation}}%
  % PGFPlots divides an integer tick count by this value: keep it integral.
  \pgfmathtruncatemacro{\academic@tick@spacing}
    {35*\academic@scale@num/\academic@scale@den}%
  \pgfplotsset{every axis/.append style={font=\academicfont{chart-label},
    max space between ticks=\academic@tick@spacing,
    major tick length=\academicdim{.15cm},minor tick length=\academicdim{.1cm},
    mark size=\academicdim{2pt}},
    every axis legend/.append style={font=\academicfont{chart-label}}}%
}
