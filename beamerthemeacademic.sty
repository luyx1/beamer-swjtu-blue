% 唯一科研卡片接口：公式、示例、结论等通过标题和正文表达语义。
\NewDocumentEnvironment{ResearchCard}{ O{} m +b }{%
  \beamer@academic@researchcard@prepare{#1}%
  \begin{tcolorbox}[researchcard adaptive,\beamer@academic@researchcard@options,%
    title={\beamer@academic@researchcard@title{#1}{#2}}]%
    #3%
  \end{tcolorbox}%
}{ }

% 学术三线表：底纹、规则线颜色与线宽统一由主题参数控制。
% Lightweight scientific content primitives. These have no icons, automatic
% numbers, title bars or decorative cards. Use them for ordinary slides.
\newcommand{\ResearchLead}[1]{%
  \par\noindent{\color{PrimaryC}\academicfont{larger}\bfseries #1}\par\medskip%
}
\newcommand{\ResearchHeading}[1]{%
