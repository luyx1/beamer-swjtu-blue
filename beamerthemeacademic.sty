	    	\IfBooleanTF{#3}{\ifstrempty{#2}{}{#2}}{%
	    		\beamer@academic@codename~\thetcbcounter%
	    		\ifstrempty{#2}{}{:~#2}%
	    	}%
	    },%
      before upper=\academicfont{caption}{以下是文件\texttt{#7}中包含的源码:\vspace{.75ex}},%
	    IfValueT={#4}{label={code\kvtcb@label@sep#4}},%
	    nameref={#2}, codestyle={\faFileCode[regular]}, #1%
  }
  \DeclareTCBInputListing[no counter]%
  % #1: <可选>附加参数 - Tcolorbox.
  % #2: 标题.
  % #3: <可选>模式选择 - 带 * 即不显示区块标题前缀.
  % #4: <可选>后缀 - 标签.
  % #5: 抄录语言.
  % #6: <可选>附加参数 - minted.
  % #7: 文件名.
  % #8: 注释定界符.
	  {\academiccodeinputnocounter}{ O{} m s O{} m O{} m !D''{||} }{%
	  	listing file={./sourcecode/#7},%
	  	listing engine=listings,%
	  	listing options={%
	  		language={#5},%
	  		breaklines, tabsize=2,%style=tcblatex,
	  		columns=flexible,%
	  		escapeinside=#8, texcl,%
      numberstyle=\academicfont{code-number}\color{CodeLineNumberC},%
        basicstyle=\academicfont{code}\ttfamily,%
      keywordstyle=\color{AuxiliaryC}\bfseries,%
      commentstyle=\color{CodeCommentC}\itshape,%
        stringstyle=\color{AlertedTextC},%
        numbers=left, numbersep=\academicdim{2pt},%
        aboveskip=-\academicdim{2pt}, belowskip=-\academicdim{2pt},%
        xrightmargin=-\academicdim{2pt},%
	  		extendedchars=true, #6%
	  	},%
	  	title={%
	  		\IfBooleanTF{#3}{\ifstrempty{#2}{}{#2}}{%
	  			\beamer@academic@codename\ifstrempty{#2}{}{:~#2}%
	  		}%
	  	},%
      before upper=\academicfont{caption}{以下是文件\texttt{#7}中包含的源码:\vspace{.75ex}},%
	  	IfValueT={#4}{label={code\kvtcb@label@sep#4}},%
	  	nameref={#2}, codestyle={\faFileCode[regular]}, #1%
  }
\fi\fi

% 新的代码展示接口：沿用主题所选的 minted/listings 引擎和统一代码字号。
% CodePanel 参数：可选 tcolorbox 参数、标题、语言、可选的逗号分隔高亮行号。
% CodeLine 参数：可选 tcolorbox 参数、标题、语言；不显示行号。
\if\EqualOptionsBeamer{CodeDisplay}{minted}%
  \DeclareTCBListing[no counter]{CodePanel}{ O{} m m O{} }{%
    listing engine=minted,%
    minted language={#3},%
    minted options={%
      autogobble,tabsize=2,breaklines,breakbytokenanywhere,%
      highlightlines={#4},highlightcolor=HighlightCodeLineC,%
      linenos,numbersep=\academicdim{4pt},%
      fontsize=\academicfont{code}\ttfamily,%
    },%
    title={#2},codestyle,#1%
  }%
  \DeclareTCBListing[no counter]{CodeLine}{ O{} m m }{%
    listing engine=minted,%
    minted language={#3},%
    minted options={%
      autogobble,tabsize=2,breaklines,breakbytokenanywhere,%
      fontsize=\academicfont{code}\ttfamily,%
    },%
    title={#2},codestyle,#1%
  }%
\else\if\EqualOptionsBeamer{CodeDisplay}{listing}%
  \RequirePackage{lstautogobble}%
  % 按 listings 的源码行计数绘制整行底色；未指定时对其他列表无影响。
  \def\beamer@academic@code@highlightlines{}%
  \newcommand{\beamer@academic@code@linebackground}{%
    \ifstrempty{\beamer@academic@code@highlightlines}{}{%
      \@for\beamer@academic@code@highlightline:=\beamer@academic@code@highlightlines\do{%
        \ifnum\lst@lineno=\beamer@academic@code@highlightline\relax
          \rlap{\color{HighlightCodeLineC}%
            \rule[-\dp\strutbox]{\linewidth}%
              {\dimexpr\ht\strutbox+\dp\strutbox\relax}}%
        \fi
      }%
    }%
  }%
  \lst@AddToHook{EveryLine}{\beamer@academic@code@linebackground}%
  \lst@Key{codepanelhighlights}{}%
    {\def\beamer@academic@code@highlightlines{#1}}%
  \DeclareTCBListing[no counter]{CodePanel}{ O{} m m O{} }{%
    listing engine=listings,%
    listing options={%
      language={#3},breaklines,tabsize=2,columns=flexible,autogobble,%
      basicstyle=\academicfont{code}\ttfamily,%
      keywordstyle=\color{AuxiliaryC}\bfseries,%
      commentstyle=\color{CodeCommentC}\itshape,%
      stringstyle=\color{AlertedTextC},%
      numbers=left,numberstyle=\academicfont{code-number}\color{CodeLineNumberC},%
      numbersep=\academicdim{4pt},aboveskip=0pt,belowskip=0pt,%
      codepanelhighlights={#4},%
    },%
    title={#2},codestyle,%
    left=\academicdim{2pt},lefttitle=\academicdim{2pt},#1%
  }%
  \DeclareTCBListing[no counter]{CodeLine}{ O{} m m }{%
    listing engine=listings,%
    listing options={%
      language={#3},breaklines,tabsize=2,columns=flexible,autogobble,%
      basicstyle=\academicfont{code}\ttfamily,%
      keywordstyle=\color{AuxiliaryC}\bfseries,%
      commentstyle=\color{CodeCommentC}\itshape,%
      stringstyle=\color{AlertedTextC},%
      numbers=none,aboveskip=0pt,belowskip=0pt,%
    },%
    title={#2},codestyle,#1%
  }%
\fi\fi

% 智能引用名称定义.
\Crefname{beamer@academic@code@count}%
  {\beamer@academic@codename}%
  {\beamer@academic@codename@pl}
