% ----------------
% Declare of Options
% ColorDisplay is retained for source compatibility. The redesigned theme
% intentionally uses one fixed palette for every display mode.
% ----------------
\DeclareOptionBeamer{ColorDisplay}{\def\beamer@swjtu@ColorDisplay{#1}}
\ExecuteOptionsBeamer{ColorDisplay=BSblue}
\ProcessOptionsBeamer
% ----------------

% ----------------
% Declare of Packages
% ----------------
\RequirePackage{xcolor}% xcolor: 设置颜色.
\RequirePackage{colortbl}% colortbl: 为表格单元格与交替行着色.
% ----------------

\mode<presentation>

% ----------------
% Academic Blue Engineering palette
% ----------------
% 基础颜色.
\definecolor{PrimaryC}{HTML}{173B75}
\definecolor{AuxiliaryC}{HTML}{235F9E}
\definecolor{SecondaryAuxiliaryC}{HTML}{146F68}
\definecolor{IntersperseC}{HTML}{B45929}
\definecolor{AlertedTextC}{HTML}{B45929}
\definecolor{NormalTextC}{HTML}{243B55}
\definecolor{MutedTextC}{HTML}{52606C}
\definecolor{BackgroundC}{HTML}{FFFFFF}
\definecolor{BorderC}{HTML}{7895AF}

% 内容模块背景.
\definecolor{BlockNormalBgC}{HTML}{FFFFFF}
\definecolor{BlockWarmBgC}{HTML}{FFFFFF}
\definecolor{BlockCoolBgC}{HTML}{FFFFFF}
\colorlet{BlockDefinitionC}{BackgroundC}
\colorlet{BlockTheoremC}{BackgroundC}
\colorlet{BlockLemmaC}{BackgroundC}
\colorlet{BlockConditionC}{BackgroundC}
\colorlet{BlockExampleC}{BackgroundC}
\colorlet{BlockFormulaC}{BackgroundC}
\colorlet{BlockConclusionC}{BackgroundC}
\colorlet{BlockQuestionC}{BackgroundC}

% 科研图表颜色.
\colorlet{ChartPrimaryC}{AuxiliaryC}
\colorlet{ChartSecondaryC}{IntersperseC}
\colorlet{ChartContrastC}{SecondaryAuxiliaryC}
\definecolor{ChartFourthC}{HTML}{70528B}
\definecolor{ChartAxisC}{HTML}{243B55}
\definecolor{ChartGridC}{HTML}{A5B4C2}

% 代码颜色.
\colorlet{CodeCommentC}{SecondaryAuxiliaryC}
