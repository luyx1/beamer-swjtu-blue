% 表格颜色：深蓝表头、蓝白交替正文和分层学术规则线.
\colorlet{TableHeaderTextC}{white}
\definecolor{TableHeaderC}{HTML}{235F9E}
\definecolor{TableBodyC}{HTML}{FFFFFF}
\definecolor{TableStripeC}{HTML}{EEF4FA}
% TableAlternateC 供既有非表格示意图使用，保持兼容；表格条纹使用 TableStripeC.
\colorlet{TableAlternateC}{TableBodyC}
\definecolor{TableRuleC}{HTML}{235F9E}
