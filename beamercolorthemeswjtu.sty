% ----------------
% Declare of Options
% Confirmed in v1.3c(2024/04/16).
% Established in v1.2a(2022/03/10).
% Updated in v1.3a(2022/03/16), v1.3b(2022/04/13).
% ----------------
% CMD:: \DeclareOptionBeamer  - 声明参数.
% CMD:: \ExecuteOptionsBeamer - 预执行参数.
% CMD:: \ProcessOptionsBeamer - 处理参数.
% ----------------
% KEY:: ColorDisplay.
% VALUE:: JXred | BSblue | Custom.
\DeclareOptionBeamer{ColorDisplay}{\def\beamer@swjtu@ColorDisplay{#1}}

\ExecuteOptionsBeamer{ColorDisplay=JXred}
\ProcessOptionsBeamer
% ----------------


% ----------------
% Declare of Packages
% Confirmed in v1.3c(2024/04/16).
% Established in v1.3b(2022/04/13).
% ----------------
% CMD:: \RequirePackage - 调用宏包.
% ----------------
\RequirePackage{xcolor}% xcolor: 设置颜色.
% ----------------


% ----------------
% Declare of Colors
% Confirmed in v1.3c(2024/04/16).
% Established in v1.2a(2022/03/10).
% Updated in v1.3a(2022/03/16).
% ----------------
% 定义主题色 swjtured, swjtugrey, 与辅助色 swjtublue, swjtugreen, swjtuyellow.
% 上述定义颜色均采用 CMYK 颜色模式.
% 注: 常用的颜色模式有 RGB 与 CMYK, 对应 LaTeX 中 rgb(0-1小数制, x/255), RGB(原始数值), cmyk(0-1小数制, x/100).
% ----------------
% CMD:: \definecolor - 依据颜色代码定义新颜色.
% CMD:: \colorlet    - 依据已有颜色延申新颜色.
% ----------------
% COLOR:: 锦绣红 - swjtured    - CMYK(12,92,95,20).
\definecolor{swjtured}   {cmyk}{0.12,0.92,0.95,0.20}
\colorlet{swjtured10}   {swjtured!10!white}
\colorlet{swjtured20}   {swjtured!20!white}
\colorlet{swjtured30}   {swjtured!30!white}
\colorlet{swjtured40}   {swjtured!40!white}
\colorlet{swjtured50}   {swjtured!50!white}
\colorlet{swjtured60}   {swjtured!60!white}
\colorlet{swjtured70}   {swjtured!70!white}
\colorlet{swjtured80}   {swjtured!80!white}
\colorlet{swjtured90}   {swjtured!90!white}

% COLOR:: 优雅灰 - swjtugrey   - CMYK(47,37,37,20).
\definecolor{swjtugrey}  {cmyk}{0.47,0.37,0.37,0.00}
\colorlet{swjtugrey10}  {swjtugrey!10!white}
\colorlet{swjtugrey20}  {swjtugrey!20!white}
\colorlet{swjtugrey30}  {swjtugrey!30!white}
\colorlet{swjtugrey40}  {swjtugrey!40!white}
\colorlet{swjtugrey50}  {swjtugrey!50!white}
\colorlet{swjtugrey60}  {swjtugrey!60!white}
\colorlet{swjtugrey70}  {swjtugrey!70!white}
\colorlet{swjtugrey80}  {swjtugrey!80!white}
\colorlet{swjtugrey90}  {swjtugrey!90!white}

% COLOR:: 宝石蓝 - swjtublue   - CMYK(100,60,0,15).
\definecolor{swjtublue}  {cmyk}{1.00,0.60,0.00,0.15}
\colorlet{swjtublue10}  {swjtublue!10!white}
\colorlet{swjtublue20}  {swjtublue!20!white}
\colorlet{swjtublue30}  {swjtublue!30!white}
\colorlet{swjtublue40}  {swjtublue!40!white}
\colorlet{swjtublue50}  {swjtublue!50!white}
\colorlet{swjtublue60}  {swjtublue!60!white}
\colorlet{swjtublue70}  {swjtublue!70!white}
\colorlet{swjtublue80}  {swjtublue!80!white}
\colorlet{swjtublue90}  {swjtublue!90!white}

% COLOR:: 荷叶绿 - swjtugreen  - CMYK(100,0,90,15).
\definecolor{swjtugreen} {cmyk}{1.00,0.00,0.90,0.15}
\colorlet{swjtugreen10} {swjtugreen!10!white}
\colorlet{swjtugreen20} {swjtugreen!20!white}
\colorlet{swjtugreen30} {swjtugreen!30!white}
\colorlet{swjtugreen40} {swjtugreen!40!white}
\colorlet{swjtugreen50} {swjtugreen!50!white}
\colorlet{swjtugreen60} {swjtugreen!60!white}
\colorlet{swjtugreen70} {swjtugreen!70!white}
\colorlet{swjtugreen80} {swjtugreen!80!white}
\colorlet{swjtugreen90} {swjtugreen!90!white}

% COLOR:: 银杏黄 - swjtuyellow - CMYK(0,40,100,15).
\definecolor{swjtuyellow}{cmyk}{0.00,0.40,1.00,0.15}
\colorlet{swjtuyellow10}{swjtuyellow!10!white}
\colorlet{swjtuyellow20}{swjtuyellow!20!white}
\colorlet{swjtuyellow30}{swjtuyellow!30!white}
\colorlet{swjtuyellow40}{swjtuyellow!40!white}
\colorlet{swjtuyellow50}{swjtuyellow!50!white}
\colorlet{swjtuyellow60}{swjtuyellow!60!white}
\colorlet{swjtuyellow70}{swjtuyellow!70!white}
\colorlet{swjtuyellow80}{swjtuyellow!80!white}
\colorlet{swjtuyellow90}{swjtuyellow!90!white}
% ----------------


\mode<presentation>


% ----------------
% Beamer Theme Color Mode Layout
% Confirmed in v1.3c(2024/04/16).
% Established in v1.3a(2022/03/16).
% Updated in v1.3c(2024/04/16).
% ----------------
% | PrimaryC | AuxiliaryC | SecondaryAuxiliaryC | IntersperseC ||
% | 主题色    | 辅助色     | 第二辅助色           | 点缀色        |
% --------------------------------------------------------------
% | NomalTextC | AlertedTextC | BackgroundC | BlockExampleC  |
% | 普通文本色  | 强调文本色    | 背景主体色   | Example 区块色 |
% ------------------------------------------------------------
% | BlockDefinitionC | BlockLemmaC | BlockConditionC |
% | Definition 区块色 | Lemma 区块色| Condition 区块色 |
% ----------------
\if\EqualOptionsBeamer{ColorDisplay}{JXred}%
	\colorlet{PrimaryC}           {swjtured}
	\colorlet{AuxiliaryC}         {swjtugrey50}
	\colorlet{SecondaryAuxiliaryC}{swjtugrey}
	\colorlet{IntersperseC}       {swjtured60}
	\colorlet{NomalTextC}         {black}
	\colorlet{AlertedTextC}       {swjtured90}
	\colorlet{BackgroundC}        {white}
	\colorlet{BlockExampleC}      {swjtugrey!80!black}
	\colorlet{BlockDefinitionC}   {swjtublue}
	\colorlet{BlockLemmaC}        {swjtugreen}
	\colorlet{BlockConditionC}    {swjtuyellow}
	\colorlet{HighlightCodeLineC} {swjtured10}
\else\if\EqualOptionsBeamer{ColorDisplay}{BSblue}%
	\colorlet{PrimaryC}           {swjtublue}
	\colorlet{AuxiliaryC}         {swjtugrey50}
	\colorlet{SecondaryAuxiliaryC}{swjtugrey}
	\colorlet{IntersperseC}       {swjtublue60}
	\colorlet{NomalTextC}         {black}
	\colorlet{AlertedTextC}       {swjtublue90}
	\colorlet{BackgroundC}        {white}
	\colorlet{BlockExampleC}      {swjtugrey!80!black}
	\colorlet{BlockDefinitionC}   {swjtured}
	\colorlet{BlockLemmaC}        {swjtugreen}
	\colorlet{BlockConditionC}    {swjtuyellow}
	\colorlet{HighlightCodeLineC} {swjtublue10}
\else\if\EqualOptionsBeamer{ColorDisplay}{Custom}%
	\def\beamer@swjtu@colorprovide#1#2{%
		% #1:: colorname.
		% #2:: set color.
		\@ifundefined{\string\color@#1}{\colorlet{#1}{#2}}{}%
	}
	\beamer@swjtu@colorprovide{PrimaryC}           {swjtured}
	\beamer@swjtu@colorprovide{AuxiliaryC}         {swjtugrey50}
	\beamer@swjtu@colorprovide{SecondaryAuxiliaryC}{swjtugrey}
	\beamer@swjtu@colorprovide{IntersperseC}       {swjtured60}
	\beamer@swjtu@colorprovide{NomalTextC}         {black}
	\beamer@swjtu@colorprovide{AlertedTextC}       {swjtured90}
	\beamer@swjtu@colorprovide{BackgroundC}        {white}
	\beamer@swjtu@colorprovide{BlockExampleC}      {swjtugrey!80!black}
	\beamer@swjtu@colorprovide{BlockDefinitionC}   {swjtublue}
	\beamer@swjtu@colorprovide{BlockLemmaC}        {swjtugreen}
	\beamer@swjtu@colorprovide{BlockConditionC}    {swjtuyellow}
	\beamer@swjtu@colorprovide{HighlightCodeLineC} {swjtured10}
\fi\fi\fi
% ----------------


% ----------------
% Beamer Theme Color Layout
% Confirmed in v1.3e(2024/10/31).
% Established in v1.2a(2022/03/10).
% Updated in v1.3a(2022/03/16), v1.3c(2024/04/16), v1.3e(2024/10/31).
% ----------------
% 基本颜色设置.
\setbeamercolor{structure}{fg=PrimaryC}
\setbeamercolor{background canvas}{bg=BackgroundC}

% 调色板颜色设置.
\setbeamercolor{palette primary}   {fg=BackgroundC, bg=PrimaryC}
\setbeamercolor{palette secondary} {fg=NomalTextC}
\setbeamercolor{palette tertiary}  {fg=AlertedTextC}
\setbeamercolor{palette quaternary}{fg=AuxiliaryC, bg=IntersperseC}

% 页眉页脚颜色设置.
\setbeamercolor{section in head/foot}    {parent=palette primary}
\setbeamercolor{subsection in head/foot} {parent=structure}
\setbeamercolor{frametitle}              {parent=structure}
\setbeamercolor{framesubtitle}           {parent=palette tertiary}
\setbeamercolor{author in head/foot}     {parent=palette secondary}
\setbeamercolor{title in head/foot}      {parent=structure}
\setbeamercolor{framenumber in head/foot}{parent=structure}

% 封页颜色设置.
\setbeamercolor{title}          {bg=BackgroundC, fg=PrimaryC}
\setbeamercolor{subtitle}       {bg=BackgroundC, fg=PrimaryC}
%\setbeamercolor{author}         {fg=white,bg=}
%\setbeamercolor{date}           {fg=white,bg=}
\setbeamercolor{titlepageheader}{bg=white, fg=black}
\setbeamercolor{titlepagefooter}{bg=white, fg=black}

% 区块颜色设置.
\setbeamercolor*{block title}        {parent=palette primary}
\setbeamercolor*{block body}         {fg=, bg=swjtured40}
\setbeamercolor*{block title example}{fg=white, bg=swjtublue}
\setbeamercolor*{block body example} {fg=, bg=swjtublue40}
\setbeamercolor*{block title alerted}{parent=palette primary}
\setbeamercolor*{block body alerted} {fg=, bg=swjtured40}

% 列表颜色设置.
\setbeamercolor{item}                {parent=structure}
\setbeamercolor{item projected}      {parent=structure}
\setbeamercolor{enumerate item}      {parent=structure}
\setbeamercolor{enumerate subitem}   {parent=structure}
\setbeamercolor{enumerate subsubitem}{parent=structure}

% 文本颜色设置.
\setbeamercolor*{normal text} {parent=palette secondary}
\setbeamercolor*{alerted text}{parent=palette tertiary}
% ----------------


