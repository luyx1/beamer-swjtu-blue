% ----------------
% Beamer Theme Title Page Layout
% Confirmed in v2.1b(2025/10/06).
% Established in v1.3c(2024/04/16).
% Updated in v2.1b(2025/10/06).
% ----------------
% CMD:: \newdimen   - 创建长度寄存器.
% CMD:: \newsavebox - 创建盒子.
% ----------------
% DIMEN:: title 框底部高度 - len@titlelow.
\newdimen\beamer@academic@len@titlelow
\beamer@academic@len@titlelow=0.4\paperheight
% DIMEN:: title 框顶部高度 - len@titlehigh.
\newdimen\beamer@academic@len@titlehigh
\beamer@academic@len@titlehigh=0.65\paperheight
% DIMEN:: title 框文字顶部高度 - len@titletexthigh.
\newdimen\beamer@academic@len@titletexthigh
\beamer@academic@len@titletexthigh=\dimexpr\beamer@academic@len@titlehigh-0.025\paperheight\relax
% DIMEN:: author 框顶部高度 - len@authorhigh.
\newdimen\beamer@academic@len@authorhigh
\beamer@academic@len@authorhigh=0.475\paperheight
% DIMEN:: author 框文字顶部高度 - len@authortexthigh.
\newdimen\beamer@academic@len@authortexthigh
\beamer@academic@len@authortexthigh=\dimexpr\beamer@academic@len@authorhigh-0.025\paperheight\relax
% DIMEN:: author 框最小宽度 - len@authorwidthmin.
\newdimen\beamer@academic@len@authorwidthmin
\beamer@academic@len@authorwidthmin=0.75\paperwidth
% DIMEN:: author 框顶部到 title 框底部距离 - len@titletoauthor.
\newdimen\beamer@academic@len@titletoauthor
\beamer@academic@len@titletoauthor=\dimexpr\beamer@academic@len@authorhigh-\beamer@academic@len@titlelow+\academicdim{0.2pt}\relax
% DIMEN:: author 框高度 - len@titletoauthor.
\newdimen\beamer@academic@len@authorheight

% 封面样式定义.
\defbeamertemplate*{title page}{Academic title page theme}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=\paperheight]{}%
    \begin{tikzpicture}[remember picture,overlay]%
      % SVG 负责封面装饰；标题由 LaTeX 按 SVG 坐标系居中排版。
      \node[anchor=center,inner sep=0pt,outer sep=0pt] at (current page.center) {%
        \pgfuseimage{academic-cover-bg}%
      };
      % SVG 标题基线位于画布中心上方约 3pt；x 坐标严格对齐画布中心。
      \node[anchor=base,align=center,text width=.90\paperwidth,
        inner sep=0pt,outer sep=0pt,text=PrimaryC] at
        ([yshift=\academicdim{3pt}]current page.center) {%
        {\usebeamerfont{title}\academictitlefont\academicfont{cover-title}\bfseries\inserttitle}%
      };
      % 横线在封面高度的 525.5/941 处；正文从其下方开始。
      \node[anchor=north,align=center,text width=.75\paperwidth,
        inner sep=0pt,outer sep=0pt,text=NormalTextC] at
        ([yshift=-.095\paperheight]current page.center) {%
        \academicbodyfont
        \ifx\insertsubtitle\@empty\else
          {\usebeamerfont{subtitle}\insertsubtitle\par}\medskip
        \fi
        % 元信息按自然段排版；空作者/空单位均可正常编译。
        % Avoid conditionals spanning tabular alignment cells.
        \ifx\insertauthor\@empty\else
          {\academicfont{body}\bfseries \insertauthor\par}
        \fi
        \ifx\insertinstitute\@empty\else
          {\academicfont{body}\insertinstitute\par}
        \fi
        \ifx\insertdate\@empty\else \smallskip\insertdate\par\fi
      };
    \end{tikzpicture}%
  \end{beamercolorbox}%
}
\setbeamertemplate{title page}[Academic title page theme]
% ----------------

% ClosingPage：编辑式收尾页，与正文的模块化内容区形成区别。
% 通过留白、左对齐标题、细线和轻量几何装饰建立层次；不依赖外部图片。
\NewDocumentCommand{\ClosingPage}{ G{感谢聆听} G{欢迎交流与指正} }{%
  \begingroup
    \setbeamertemplate{background}{}%
    \setbeamercolor{background canvas}{bg=BackgroundC}%
    \setbeamertemplate{headline}{}%
    \setbeamertemplate{footline}{}%
    \setbeamertemplate{navigation symbols}{}%
    \begin{frame}[plain,noframenumbering]
      \begin{tikzpicture}[remember picture,overlay]
        % Narrow brand rail and a quiet right-side field.
        \fill[PrimaryC]
          (current page.north west)
          rectangle ([xshift=\academicdim{2pt}]current page.south west);
        \fill[AuxiliaryC!4]
          ([xshift=.80\paperwidth]current page.north west)
          rectangle (current page.south east);

        % Abstract line work adds movement without introducing another card.
        \draw[AuxiliaryC!22,line width=\academicdim{.7pt}]
          ([xshift=.76\paperwidth,yshift=-.24\paperheight]current page.north west)
          .. controls
            ([xshift=.83\paperwidth,yshift=-.16\paperheight]current page.north west)
            and
            ([xshift=.92\paperwidth,yshift=-.34\paperheight]current page.north west)
          .. ([xshift=.97\paperwidth,yshift=-.27\paperheight]current page.north west);
        \draw[AuxiliaryC!16,line width=\academicdim{.7pt}]
          ([xshift=.76\paperwidth,yshift=-.34\paperheight]current page.north west)
          .. controls
            ([xshift=.84\paperwidth,yshift=-.26\paperheight]current page.north west)
            and
            ([xshift=.91\paperwidth,yshift=-.43\paperheight]current page.north west)
          .. ([xshift=.97\paperwidth,yshift=-.36\paperheight]current page.north west);
        \draw[AuxiliaryC!12,line width=\academicdim{.7pt}]
          ([xshift=.76\paperwidth,yshift=-.44\paperheight]current page.north west)
          .. controls
            ([xshift=.84\paperwidth,yshift=-.36\paperheight]current page.north west)
            and
            ([xshift=.92\paperwidth,yshift=-.53\paperheight]current page.north west)
          .. ([xshift=.97\paperwidth,yshift=-.46\paperheight]current page.north west);

        \node[anchor=west,inner sep=0pt]
          at ([xshift=.105\paperwidth,yshift=-.255\paperheight]current page.north west)
          {\color{AuxiliaryC}\academicfont{caption}\bfseries
            SOUTHWEST JIAOTONG UNIVERSITY};

        \node[anchor=west,align=left,text width=.66\paperwidth,inner sep=0pt]
          at ([xshift=.105\paperwidth,yshift=-.405\paperheight]current page.north west)
          {\color{PrimaryC}\academicfont{closing-title}\bfseries #1};

        \draw[PrimaryC,line width=\academicdim{1.2pt}]
          ([xshift=.105\paperwidth,yshift=-.525\paperheight]current page.north west)
          -- ([xshift=.235\paperwidth,yshift=-.525\paperheight]current page.north west);

        \node[anchor=west,align=left,text width=.66\paperwidth,inner sep=0pt]
          at ([xshift=.105\paperwidth,yshift=-.605\paperheight]current page.north west)
          {\color{NormalTextC}\academicfont{closing-subtitle}\mdseries #2};

        \node[anchor=west,inner sep=0pt]
          at ([xshift=.105\paperwidth,yshift=-.865\paperheight]current page.north west)
          {\color{MutedTextC}\academicfont{caption}\insertinstitute};

        \node[anchor=east,inner sep=0pt]
          at ([xshift=-.085\paperwidth,yshift=-.865\paperheight]current page.north east)
          {\color{MutedTextC}\academicfont{caption}\insertdate};
      \end{tikzpicture}%
    \end{frame}
  \endgroup
}

