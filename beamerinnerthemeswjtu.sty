\mode<presentation>


% ----------------
% Beamer Theme Title Page Layout
% Confirmed in v2.1b(2025/10/06).
% Established in v1.3c(2024/04/16).
% Updated in v2.1b(2025/10/06).
% ----------------
% CMD:: \newdimen   - 创建长度寄存器.
% CMD:: \newsavebox - 创建盒子.
% ----------------
% DIMEN:: title 框底部高度 - len@titlelow.
\newdimen\beamer@swjtu@len@titlelow
\beamer@swjtu@len@titlelow=0.4\paperheight
% DIMEN:: title 框顶部高度 - len@titlehigh.
\newdimen\beamer@swjtu@len@titlehigh
\beamer@swjtu@len@titlehigh=0.65\paperheight
% DIMEN:: title 框文字顶部高度 - len@titletexthigh.
\newdimen\beamer@swjtu@len@titletexthigh
\beamer@swjtu@len@titletexthigh=\dimexpr\beamer@swjtu@len@titlehigh-0.025\paperheight\relax
% DIMEN:: author 框顶部高度 - len@authorhigh.
\newdimen\beamer@swjtu@len@authorhigh
\beamer@swjtu@len@authorhigh=0.475\paperheight
% DIMEN:: author 框文字顶部高度 - len@authortexthigh.
\newdimen\beamer@swjtu@len@authortexthigh
\beamer@swjtu@len@authortexthigh=\dimexpr\beamer@swjtu@len@authorhigh-0.025\paperheight\relax
% DIMEN:: author 框最小宽度 - len@authorwidthmin.
\newdimen\beamer@swjtu@len@authorwidthmin
\beamer@swjtu@len@authorwidthmin=0.75\paperwidth
% DIMEN:: author 框顶部到 title 框底部距离 - len@titletoauthor.
\newdimen\beamer@swjtu@len@titletoauthor
\beamer@swjtu@len@titletoauthor=\dimexpr\beamer@swjtu@len@authorhigh-\beamer@swjtu@len@titlelow+0.2pt\relax
% DIMEN:: author 框高度 - len@titletoauthor.
\newdimen\beamer@swjtu@len@authorheight

% 封面样式定义.
\defbeamertemplate*{title page}{SWJTU title page theme}{%  
  \newsavebox{\beamer@swjtu@authorbox}
  \sbox{\beamer@swjtu@authorbox}{\parbox{.72\paperwidth}{%
    \setlength{\baselineskip}{10pt}%
    {\usebeamerfont{author}\insertauthor\par}%
    {\vskip6pt}%
    {\usebeamerfont{institute}\insertinstitute}%
  }}% savebox 存储
  \settototalheight{\beamer@swjtu@len@authorheight}{\usebox{\beamer@swjtu@authorbox}}% 计算高度
  \beamer@swjtu@len@authorheight=\dimexpr\beamer@swjtu@len@authorheight+0.036\paperwidth\relax% 补齐上下空白部分
  \begin{beamercolorbox}[wd=\paperwidth,ht=\paperheight]{}%
    \begin{tikzpicture}[overlay, yshift=-13.3pt]%
      \node[anchor=north west, inner sep=0pt, outer sep=0pt]%
        at (16pt, \dimexpr\paperheight-14pt\relax) {\pgfuseimage{lg-name}};% 绘制 logo-name
      \node[anchor=south east, inner sep=0pt, outer sep=0pt]%
        at (\paperwidth, \beamer@swjtu@len@titlehigh) {\pgfuseimage{building}};% 绘制校楼背景
      \fill[PrimaryC] (0, \beamer@swjtu@len@titlelow) rectangle (\paperwidth, \beamer@swjtu@len@titlehigh); % 绘制 title 框
      \node[anchor=north west, inner sep=0pt, outer sep=0pt,%
        text width=.9\paperwidth] at (16pt, \beamer@swjtu@len@titletexthigh) {%
        {\usebeamerfont{title}\usebeamercolor[bg]{title}\inserttitle\par}%
        {\vskip6pt}%
        {\usebeamerfont{subtitle}\usebeamercolor[bg]{subtitle}\insertsubtitle\par}%
      };% 绘制 title | subtitle 文字
      \fill[PrimaryC!10!BackgroundC] (0, \beamer@swjtu@len@authorhigh)%
        -- (\beamer@swjtu@len@authorwidthmin, \beamer@swjtu@len@authorhigh)%
        -- ++ (0.5\beamer@swjtu@len@authorheight, -\beamer@swjtu@len@authorheight)%
        -- (0, \dimexpr\beamer@swjtu@len@authorhigh-\beamer@swjtu@len@authorheight\relax)%
        -- cycle;% 绘制 author 框
      \fill[BackgroundC] (0, \beamer@swjtu@len@authorhigh)%
        -- (\dimexpr\beamer@swjtu@len@authorwidthmin+1.56pt\relax, \beamer@swjtu@len@authorhigh)%
        -- ++ (\dimexpr0.5\beamer@swjtu@len@titletoauthor\relax, -\beamer@swjtu@len@titletoauthor)%
        -- ++ (-1.6pt, 0)%
        -- ++ (-\dimexpr0.5\beamer@swjtu@len@titletoauthor-0.8pt\relax, \dimexpr\beamer@swjtu@len@titletoauthor-1.6pt\relax)%
        -- (0, \dimexpr\beamer@swjtu@len@authorhigh-1.6pt\relax) -- cycle;% 绘制装饰线
      \node[anchor=north west, inner sep=0pt, outer sep=0pt]%
        at (16pt, \beamer@swjtu@len@authortexthigh) (AuthorText) {\usebox{\beamer@swjtu@authorbox}};% 绘制 author | institute 文字
      \node[anchor=south west, inner sep=0pt, outer sep=0pt] at (16pt, 14pt) {\usebeamerfont{date}\insertdate};% 绘制 date 文字
      \node[anchor=south east, inner sep=0pt, outer sep=0pt] at (\dimexpr\paperwidth-16pt\relax, 14pt) {\pgfuseimage{verify}};% 绘制 verify 校训
      % \node[anchor=south west,draw] at (0, 0) {00};
    \end{tikzpicture}%
  \end{beamercolorbox}%
}
\setbeamertemplate{title page}[SWJTU title page theme]
