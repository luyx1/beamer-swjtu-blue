% ----------------
% Beamer Theme Title Page Layout
% Confirmed in v2.1b(2025/10/06).
% Established in v1.3c(2024/04/16).
% Updated in v2.1b(2025/10/06).
% ----------------
% CMD:: \newdimen   - 创建长度寄存器.
% CMD:: \newsavebox - 创建盒子.
% ----------------
% DIMEN:: title 框底部高度 - len@titlelow.
\newdimen\beamer@swjtu@len@titlelow
\beamer@swjtu@len@titlelow=0.4\paperheight
% DIMEN:: title 框顶部高度 - len@titlehigh.
\newdimen\beamer@swjtu@len@titlehigh
\beamer@swjtu@len@titlehigh=0.65\paperheight
% DIMEN:: title 框文字顶部高度 - len@titletexthigh.
\newdimen\beamer@swjtu@len@titletexthigh
\beamer@swjtu@len@titletexthigh=\dimexpr\beamer@swjtu@len@titlehigh-0.025\paperheight\relax
% DIMEN:: author 框顶部高度 - len@authorhigh.
\newdimen\beamer@swjtu@len@authorhigh
\beamer@swjtu@len@authorhigh=0.475\paperheight
% DIMEN:: author 框文字顶部高度 - len@authortexthigh.
\newdimen\beamer@swjtu@len@authortexthigh
\beamer@swjtu@len@authortexthigh=\dimexpr\beamer@swjtu@len@authorhigh-0.025\paperheight\relax
% DIMEN:: author 框最小宽度 - len@authorwidthmin.
\newdimen\beamer@swjtu@len@authorwidthmin
\beamer@swjtu@len@authorwidthmin=0.75\paperwidth
% DIMEN:: author 框顶部到 title 框底部距离 - len@titletoauthor.
\newdimen\beamer@swjtu@len@titletoauthor
\beamer@swjtu@len@titletoauthor=\dimexpr\beamer@swjtu@len@authorhigh-\beamer@swjtu@len@titlelow+\swjtudim{0.2pt}\relax
% DIMEN:: author 框高度 - len@titletoauthor.
\newdimen\beamer@swjtu@len@authorheight

% 封面样式定义.
\defbeamertemplate*{title page}{SWJTU title page theme}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=\paperheight]{}%
    \begin{tikzpicture}[remember picture,overlay]%
      % SVG 负责封面装饰；标题由 LaTeX 按 SVG 坐标系居中排版。
      \node[anchor=center,inner sep=0pt,outer sep=0pt] at (current page.center) {%
        \pgfuseimage{swjtu-cover-bg}%
      };
      % SVG 标题基线位于画布中心上方约 3pt；x 坐标严格对齐画布中心。
      \node[anchor=base,align=center,text width=.90\paperwidth,
        inner sep=0pt,outer sep=0pt,text=PrimaryC] at
        ([yshift=\swjtudim{3pt}]current page.center) {%
        {\usebeamerfont{title}\swjtutitlefont\swjtufont{cover-title}\bfseries\inserttitle}%
      };
      % 横线在封面高度的 525.5/941 处；正文从其下方开始。
      \node[anchor=north,align=center,text width=.75\paperwidth,
        inner sep=0pt,outer sep=0pt,text=NormalTextC] at
        ([yshift=-.095\paperheight]current page.center) {%
        \swjtubodyfont
        \ifx\insertsubtitle\@empty\else
          {\usebeamerfont{subtitle}\insertsubtitle\par}\medskip
        \fi
        % 元信息按自然段排版；空作者/空单位均可正常编译。
        % Avoid conditionals spanning tabular alignment cells.
        \ifx\insertauthor\@empty\else
          {\swjtufont{body}\bfseries \insertauthor\par}
        \fi
        \ifx\insertinstitute\@empty\else
          {\swjtufont{body}\insertinstitute\par}
        \fi
        \ifx\insertdate\@empty\else \smallskip\insertdate\par\fi
      };
    \end{tikzpicture}%
  \end{beamercolorbox}%
}
\setbeamertemplate{title page}[SWJTU title page theme]
% ----------------

% ClosingPage：复用统一字体与配色，局部隐藏页眉、页脚和导航。
% 无参数时使用课题组汇报结束语；两个花括号参数用于自定义文字。
\NewDocumentCommand{\ClosingPage}{ G{汇报完毕} G{敬请批评指正} }{%
  \begingroup
    \setbeamertemplate{background}{}%
    \setbeamercolor{background canvas}{bg=BackgroundC}%
    \setbeamertemplate{headline}{}%
    \setbeamertemplate{footline}{}%
    \setbeamertemplate{navigation symbols}{}%
    \begin{frame}[plain,noframenumbering]
      \begin{tikzpicture}[remember picture,overlay]
        \node[anchor=center,inner sep=0pt,outer sep=0pt] at (current page.center) {%
          \begin{minipage}{.8\paperwidth}
            \centering
            {\color{PrimaryC}\swjtufont{closing-title}\bfseries #1\par}%
            \vspace{7mm}%
            {\color{AuxiliaryC}\rule{35mm}{0.8pt}\par}%
            \vspace{7mm}%
            {\color{TableBodyTextC}\swjtufont{closing-subtitle}\mdseries #2\par}%
          \end{minipage}%
        };
      \end{tikzpicture}%
    \end{frame}
  \endgroup
}

