% Controllable content-aware layout primitives for Beamer.
%
% The first implementation deliberately keeps the solver deterministic and
% TeX-native: blocks are measured in a reference box, a preset row structure
% is selected, and the available width is allocated subject to minwidth.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerautolayout}[2026/10/12 v0.1 Controllable content-aware Beamer layout]

\RequirePackage{expl3}
\RequirePackage{xparse}

\providecommand{\academicdim}[1]{#1}
\ExplSyntaxOn

% --------------------------------------------------------------------------
% State
% --------------------------------------------------------------------------
\seq_new:N  \g__beamerautolayout_block_ids_seq
\int_new:N  \g__beamerautolayout_block_count_int
\int_new:N  \g__beamerautolayout_instance_int

\bool_new:N \l__beamerautolayout_active_bool
\bool_new:N \l__beamerautolayout_lock_bool
\bool_new:N \l__beamerautolayout_debug_bool
\bool_new:N \l__beamerautolayout_weighted_bool
\bool_new:N \l__beamerautolayout_locked_found_bool
\bool_new:N \l__beamerautolayout_tall_content_bool

\tl_new:N   \l__beamerautolayout_mode_tl
\tl_new:N   \l__beamerautolayout_layout_tl
\tl_new:N   \l__beamerautolayout_selected_layout_tl
\tl_new:N   \l__beamerautolayout_id_tl

\dim_new:N  \l__beamerautolayout_gap_dim
\dim_new:N  \l__beamerautolayout_row_gap_dim
\dim_new:N  \l__beamerautolayout_padding_dim

\int_new:N  \l__beamerautolayout_row_index_int
\int_new:N  \l__beamerautolayout_row_count_int
\int_new:N  \l__beamerautolayout_row_slot_count_int
\int_new:N  \l__beamerautolayout_cursor_int
\int_new:N  \l__beamerautolayout_slot_index_int
\int_new:N  \l__beamerautolayout_weight_int
\int_new:N  \l__beamerautolayout_weight_sum_int
\int_new:N  \l__beamerautolayout_slot_total_int

\dim_new:N  \l__beamerautolayout_reference_width_dim
\dim_new:N  \l__beamerautolayout_row_available_dim
\dim_new:N  \l__beamerautolayout_min_sum_dim
\dim_new:N  \l__beamerautolayout_remaining_dim
\dim_new:N  \l__beamerautolayout_share_dim
\dim_new:N  \l__beamerautolayout_width_dim

\seq_new:N  \l__beamerautolayout_rows_seq
\seq_new:N  \l__beamerautolayout_row_ids_seq
\box_new:N  \l__beamerautolayout_measure_box

% Temporary values used while parsing one autoblock.
\int_new:N  \l__beamerautolayout_block_priority_int
\tl_new:N   \l__beamerautolayout_block_kind_tl
\dim_new:N  \l__beamerautolayout_block_minwidth_dim

% --------------------------------------------------------------------------
% Keys
% --------------------------------------------------------------------------
\keys_define:nn { beamerautolayout / layout }
  {
    mode .choice:,
    mode / auto .code:n =
      { \tl_set:Nn \l__beamerautolayout_mode_tl { auto } },
    mode / balanced .code:n =
      { \tl_set:Nn \l__beamerautolayout_mode_tl { balanced } },
    mode / figure-first .code:n =
      { \tl_set:Nn \l__beamerautolayout_mode_tl { figure-first } },
    mode / structured .code:n =
      { \tl_set:Nn \l__beamerautolayout_mode_tl { structured } },
    layout .tl_set:N = \l__beamerautolayout_layout_tl,
    lock-layout .bool_set:N = \l__beamerautolayout_lock_bool,
    id .tl_set:N = \l__beamerautolayout_id_tl,
    gap .dim_set:N = \l__beamerautolayout_gap_dim,
    row-gap .dim_set:N = \l__beamerautolayout_row_gap_dim,
    padding .dim_set:N = \l__beamerautolayout_padding_dim,
    debug .bool_set:N = \l__beamerautolayout_debug_bool,
  }

\keys_define:nn { beamerautolayout / block }
  {
    priority .choice:,
    priority / low .code:n =
      { \int_set:Nn \l__beamerautolayout_block_priority_int { 1 } },
    priority / normal .code:n =
      { \int_set:Nn \l__beamerautolayout_block_priority_int { 2 } },
    priority / high .code:n =
      { \int_set:Nn \l__beamerautolayout_block_priority_int { 3 } },
    kind .choice:,
    kind / auto .code:n =
      { \tl_set:Nn \l__beamerautolayout_block_kind_tl { auto } },
    kind / text .code:n =
      { \tl_set:Nn \l__beamerautolayout_block_kind_tl { text } },
    kind / figure .code:n =
      { \tl_set:Nn \l__beamerautolayout_block_kind_tl { figure } },
    kind / formula .code:n =
      { \tl_set:Nn \l__beamerautolayout_block_kind_tl { formula } },
    kind / table .code:n =
      { \tl_set:Nn \l__beamerautolayout_block_kind_tl { table } },
    minwidth .dim_set:N = \l__beamerautolayout_block_minwidth_dim,
  }

% Defaults are set at each environment start so one layout cannot leak keys
% into the next one.
\cs_new_protected:Npn \__beamerautolayout_set_layout_defaults:
  {
    \tl_set:Nn  \l__beamerautolayout_mode_tl { auto }
    \tl_set:Nn  \l__beamerautolayout_layout_tl { auto }
    \tl_clear:N \l__beamerautolayout_id_tl
    \bool_set_false:N \l__beamerautolayout_lock_bool
    \bool_set_false:N \l__beamerautolayout_debug_bool
    \dim_set:Nn \l__beamerautolayout_gap_dim { \academicdim{6pt} }
    \dim_set:Nn \l__beamerautolayout_row_gap_dim { \academicdim{6pt} }
    \dim_set:Nn \l__beamerautolayout_padding_dim { \academicdim{4pt} }
  }

\cs_new_protected:Npn \__beamerautolayout_set_block_defaults:
  {
    \int_set:Nn \l__beamerautolayout_block_priority_int { 2 }
    \tl_set:Nn  \l__beamerautolayout_block_kind_tl { auto }
    \dim_zero:N \l__beamerautolayout_block_minwidth_dim
  }

% --------------------------------------------------------------------------
% Auxiliary-file lock state
% --------------------------------------------------------------------------
% The lock is keyed by the optional id. If no id is supplied, the ordinal of
% the autolayout environment is used, which is stable as long as the document
% order is stable.
\cs_new_protected:Npn \beamerautolayoutlocked #1#2
  {
    \tl_gset:cn { g__beamerautolayout_locked_#1_tl } {#2}
  }

\cs_new_protected:Npn \__beamerautolayout_write_lock:
  {
    \typeout{beamerautolayout: writing lock for \tl_use:N \l__beamerautolayout_id_tl}
    \protected@write\@mainaux{}
      {\string\beamerautolayoutlocked
        {\tl_to_str:V \l__beamerautolayout_id_tl}
        {\tl_to_str:V \l__beamerautolayout_selected_layout_tl}}
  }

% --------------------------------------------------------------------------
% Block collection and measurement
% --------------------------------------------------------------------------
\cs_new_protected:Npn \__beamerautolayout_clear_blocks:
  {
    \seq_gclear:N \g__beamerautolayout_block_ids_seq
    \int_gzero:N \g__beamerautolayout_block_count_int
  }

\cs_new_protected:Npn \__beamerautolayout_infer_kind:n #1
  {
    \tl_if_eq:NnT \l__beamerautolayout_block_kind_tl { auto }
      {
        \tl_if_in:nnTF {#1} { \includegraphics }
          { \tl_set:Nn \l__beamerautolayout_block_kind_tl { figure } }
          {
            \tl_if_in:nnTF {#1} { tikzpicture }
              { \tl_set:Nn \l__beamerautolayout_block_kind_tl { figure } }
              { \tl_set:Nn \l__beamerautolayout_block_kind_tl { text } }
          }
      }
  }

\cs_new_protected:Npn \__beamerautolayout_store_block:nn #1#2
  {
    \__beamerautolayout_infer_kind:n {#2}
    \int_gincr:N \g__beamerautolayout_block_count_int
    \int_set_eq:NN \l_tmpa_int \g__beamerautolayout_block_count_int
    \seq_gput_right:Nx \g__beamerautolayout_block_ids_seq
      { \int_use:N \l_tmpa_int }

    \tl_gset:cn
      { g__beamerautolayout_title_\int_use:N \l_tmpa_int _tl } {#1}
    \tl_gset:cn
      { g__beamerautolayout_body_\int_use:N \l_tmpa_int _tl } {#2}
    \cs_if_exist:cF
      { g__beamerautolayout_priority_\int_use:N \l_tmpa_int _int }
      { \int_new:c
          { g__beamerautolayout_priority_\int_use:N \l_tmpa_int _int } }
    \int_gset:cn
      { g__beamerautolayout_priority_\int_use:N \l_tmpa_int _int }
      { \int_use:N \l__beamerautolayout_block_priority_int }
    \tl_gset:cn
      { g__beamerautolayout_kind_\int_use:N \l_tmpa_int _tl }
      { \tl_use:N \l__beamerautolayout_block_kind_tl }
    \cs_if_exist:cF
      { g__beamerautolayout_minwidth_\int_use:N \l_tmpa_int _dim }
      { \dim_new:c
          { g__beamerautolayout_minwidth_\int_use:N \l_tmpa_int _dim } }
    \dim_gset:cn
      { g__beamerautolayout_minwidth_\int_use:N \l_tmpa_int _dim }
      { \dim_use:N \l__beamerautolayout_block_minwidth_dim }

    % Reference measurement is heuristic: use explicit columns for fragile or
    % side-effecting material such as charts, counters and verbatim environments.
    % The content is evaluated once here and once during final rendering.
    \dim_set:Nn \l__beamerautolayout_reference_width_dim { .48\linewidth }
    \vbox_set:Nn \l__beamerautolayout_measure_box
      {
        \hsize=\l__beamerautolayout_reference_width_dim
        \linewidth=\l__beamerautolayout_reference_width_dim
        \parindent=0pt
        \noindent
        % 主题提供统一字号时，测量必须与最终卡片正文使用同一字号。
        \cs_if_exist:NT \academicbodyfont { \academicbodyfont }
        #2
        \par
      }
    \cs_if_exist:cF
      { g__beamerautolayout_refheight_\int_use:N \l_tmpa_int _dim }
      { \dim_new:c
          { g__beamerautolayout_refheight_\int_use:N \l_tmpa_int _dim } }
    \dim_gset:cn
      { g__beamerautolayout_refheight_\int_use:N \l_tmpa_int _dim }
      {
        \dim_eval:n
          { \box_ht:N \l__beamerautolayout_measure_box
            + \box_dp:N \l__beamerautolayout_measure_box }
      }
  }

% --------------------------------------------------------------------------
% Layout selection
% --------------------------------------------------------------------------
\cs_new_protected:Npn \__beamerautolayout_detect_weighted:
  {
    \bool_set_false:N \l__beamerautolayout_weighted_bool
    \tl_if_eq:NnT \l__beamerautolayout_mode_tl { figure-first }
      { \bool_set_true:N \l__beamerautolayout_weighted_bool }
    \tl_if_eq:NnT \l__beamerautolayout_mode_tl { auto }
      {
        \seq_map_inline:Nn \g__beamerautolayout_block_ids_seq
          {
            \int_compare:nNnT
              { \int_use:c { g__beamerautolayout_priority_##1_int } } > { 2 }
              { \bool_set_true:N \l__beamerautolayout_weighted_bool }
            \tl_if_eq:cnT
              { g__beamerautolayout_kind_##1_tl } { figure }
              { \bool_set_true:N \l__beamerautolayout_weighted_bool }
          }
      }
    \tl_if_eq:NnT \l__beamerautolayout_mode_tl { structured }
      {
        \seq_map_inline:Nn \g__beamerautolayout_block_ids_seq
          {
            \int_compare:nNnT
              { \int_use:c { g__beamerautolayout_priority_##1_int } } > { 2 }
              { \bool_set_true:N \l__beamerautolayout_weighted_bool }
          }
      }
  }

\cs_new_protected:Npn \__beamerautolayout_choose_balanced:
  {
    \bool_set_false:N \l__beamerautolayout_tall_content_bool
    \seq_map_inline:Nn \g__beamerautolayout_block_ids_seq
      {
        \dim_compare:nNnT
          { \dim_use:c { g__beamerautolayout_refheight_##1_dim } }
          > { .62\textheight }
          { \bool_set_true:N \l__beamerautolayout_tall_content_bool }
      }
    \int_case:nnF { \int_use:N \g__beamerautolayout_block_count_int }
      {
        { 1 } { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1 } }
        { 2 }
          {
            \bool_if:NTF \l__beamerautolayout_tall_content_bool
              { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+1 } }
              { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 2 } }
          }
        { 3 }
          {
            \bool_if:NTF \l__beamerautolayout_tall_content_bool
              { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+1+1 } }
              { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 3 } }
          }
        { 4 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 2+2 } }
        { 5 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 3+2 } }
        { 6 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 3+3 } }
        { 7 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 3+2+2 } }
        { 8 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 4+4 } }
        { 9 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 3+3+3 } }
        { 10 } { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 3+3+2+2 } }
        { 11 } { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 3+3+3+2 } }
        { 12 } { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 3+3+3+3 } }
      }
      {
        \PackageError{beamerautolayout}
          {Too~many~blocks~for~the~preset~layout~library}
          {Use~mode=structured~with~an~explicit~layout~or~split~the~content~over~multiple~frames.}
        \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 3+3+3+3 }
      }
  }

\cs_new_protected:Npn \__beamerautolayout_choose_figure_first:
  {
    \int_case:nnF { \int_use:N \g__beamerautolayout_block_count_int }
      {
        { 1 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1 } }
        { 2 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+1 } }
        { 3 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+2 } }
        { 4 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+3 } }
        { 5 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+2+2 } }
        { 6 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+2+3 } }
        { 7 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+2+2+2 } }
        { 8 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+2+2+3 } }
        { 9 }  { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+2+3+3 } }
        { 10 } { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+2+2+2+3 } }
        { 11 } { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+2+3+3+2 } }
        { 12 } { \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1+2+3+3+3 } }
      }
      { \__beamerautolayout_choose_balanced: }
  }

\cs_new_protected:Npn \__beamerautolayout_validate_layout:
  {
    \seq_set_split:NnV \l__beamerautolayout_rows_seq { + }
      \l__beamerautolayout_selected_layout_tl
    \int_zero:N \l__beamerautolayout_slot_total_int
    \seq_map_inline:Nn \l__beamerautolayout_rows_seq
      {
        \int_set:Nn \l_tmpa_int {##1}
        \int_compare:nNnT { \l_tmpa_int } < { 1 }
          {
            \PackageError{beamerautolayout}
              {Invalid~layout~row~count}
              {Each~row~in~layout=...~must~contain~a~positive~integer.}
          }
        \int_add:Nn \l__beamerautolayout_slot_total_int { \l_tmpa_int }
      }
    \int_compare:nNnT
      { \l__beamerautolayout_slot_total_int }
      < { \g__beamerautolayout_block_count_int }
      {
        \PackageError{beamerautolayout}
          {Layout~has~fewer~slots~than~autoblock~instances}
          {Add~rows~to~layout=...~or~use~mode=auto.}
        \tl_put_right:Nx \l__beamerautolayout_selected_layout_tl
          { +\int_eval:n
              { \g__beamerautolayout_block_count_int
                - \l__beamerautolayout_slot_total_int } }
      }
  }

\cs_new_protected:Npn \__beamerautolayout_select_layout:
  {
    \tl_if_blank:VTF \l__beamerautolayout_id_tl
      {
        \tl_set:Nx \l__beamerautolayout_id_tl
          { ordinal-\int_use:N \g__beamerautolayout_instance_int }
      }
      { }
    \__beamerautolayout_detect_weighted:
    \bool_set_false:N \l__beamerautolayout_locked_found_bool
    \bool_if:NT \l__beamerautolayout_lock_bool
      {
        \cs_if_exist:cT
          { g__beamerautolayout_locked_\l__beamerautolayout_id_tl _tl }
          {
            \tl_set:Nx \l__beamerautolayout_selected_layout_tl
              {
                \tl_use:c
                  { g__beamerautolayout_locked_\l__beamerautolayout_id_tl _tl }
              }
            \bool_set_true:N \l__beamerautolayout_locked_found_bool
          }
      }

    \bool_if:NF \l__beamerautolayout_locked_found_bool
      {
        \tl_if_eq:NnTF \l__beamerautolayout_layout_tl { auto }
          {
            \tl_if_eq:NnTF \l__beamerautolayout_mode_tl { structured }
              {
                \PackageError{beamerautolayout}
                  {mode=structured~requires~layout=...}
                  {For~example:~mode=structured,layout=2+2.}
                \tl_set:Nn \l__beamerautolayout_selected_layout_tl { 1 }
              }
              {
                \bool_if:NTF \l__beamerautolayout_weighted_bool
                  { \__beamerautolayout_choose_figure_first: }
                  { \__beamerautolayout_choose_balanced: }
              }
          }
          {
            \tl_set_eq:NN \l__beamerautolayout_selected_layout_tl
              \l__beamerautolayout_layout_tl
          }
      }
    \bool_if:NT \l__beamerautolayout_lock_bool
      { \__beamerautolayout_write_lock: }
    \__beamerautolayout_validate_layout:
    \bool_if:NT \l__beamerautolayout_debug_bool
      {
        \typeout{beamerautolayout: id=\tl_use:N \l__beamerautolayout_id_tl, mode=\tl_use:N \l__beamerautolayout_mode_tl, layout=\tl_use:N \l__beamerautolayout_selected_layout_tl, lock=\bool_if:NTF \l__beamerautolayout_lock_bool {true}{false}}
      }
  }

% --------------------------------------------------------------------------
% Width allocation and rendering
% --------------------------------------------------------------------------
\cs_new_protected:Npn \__beamerautolayout_weight_for:nN #1#2
  {
    \int_set:Nn #2 { 1 }
    \int_compare:nNnT
      { \int_use:c { g__beamerautolayout_priority_#1_int } } > { 2 }
      { \int_set:Nn #2 { 3 } }
    \tl_if_eq:cnT { g__beamerautolayout_kind_#1_tl } { figure }
      { \int_set:Nn #2 { 3 } }
    \tl_if_eq:cnT { g__beamerautolayout_kind_#1_tl } { formula }
      { \int_compare:nNnT { \int_use:N #2 } < { 2 } { \int_set:Nn #2 { 2 } } }
    \tl_if_eq:cnT { g__beamerautolayout_kind_#1_tl } { table }
      { \int_compare:nNnT { \int_use:N #2 } < { 2 } { \int_set:Nn #2 { 2 } } }
  }

% The automatic grid controls geometry only; it must not force a card or
% title badge onto every block. Complex charts are best placed in explicit
% columns to avoid executing drawing commands once for measurement and again
% for final rendering.
\cs_new_protected:Npn \__beamerautolayout_render_block:nn #1#2
  {
    \begin{minipage}[t]{#2}
      \vspace{0pt}
      \tl_if_empty:cF { g__beamerautolayout_title_#1_tl }
        {
          \par\noindent
          {\color{PrimaryC}
           \cs_if_exist:NTF \academiccardtitlefont
             { \academiccardtitlefont }
             { \bfseries }
           \tl_use:c { g__beamerautolayout_title_#1_tl }\par}
          \vspace{\academicdim{4pt}}
        }
      {\color{NormalTextC}
       \cs_if_exist:NT \academicbodyfont { \academicbodyfont }
       \tl_use:c { g__beamerautolayout_body_#1_tl }\par}
    \end{minipage}
  }

\cs_new_protected:Npn \__beamerautolayout_render_row:
  {
    \int_set:Nn \l__beamerautolayout_row_slot_count_int
      { \seq_count:N \l__beamerautolayout_row_ids_seq }
    \int_set:Nn \l_tmpa_int
      { \l__beamerautolayout_row_slot_count_int - 1 }
    \dim_set:Nn \l__beamerautolayout_row_available_dim
      { \dim_eval:n
          { \linewidth - \l_tmpa_int \l__beamerautolayout_gap_dim } }
    \dim_zero:N \l__beamerautolayout_min_sum_dim
    \seq_map_inline:Nn \l__beamerautolayout_row_ids_seq
      {
        \dim_add:Nn \l__beamerautolayout_min_sum_dim
          { \dim_use:c { g__beamerautolayout_minwidth_##1_dim } }
      }
    \dim_compare:nNnTF
      { \l__beamerautolayout_row_available_dim } < { 0pt }
      {
        \PackageError{beamerautolayout}
          {Layout~gap~exceeds~available~width}
          {Reduce~gap=...~or~use~fewer~columns.}
        \dim_zero:N \l__beamerautolayout_row_available_dim
      }
      { }
    \dim_compare:nNnTF
      { \l__beamerautolayout_min_sum_dim }
      > { \l__beamerautolayout_row_available_dim }
      {
        \PackageError{beamerautolayout}
          {Minimum~width~constraints~conflict~in~row~\int_use:N \l__beamerautolayout_row_index_int}
          {The~sum~of~minwidth~values~is~larger~than~the~available~row~width.}
        \dim_zero:N \l__beamerautolayout_remaining_dim
      }
      {
        \dim_set:Nn \l__beamerautolayout_remaining_dim
          { \dim_eval:n
              { \l__beamerautolayout_row_available_dim
                - \l__beamerautolayout_min_sum_dim } }
      }

    \bool_if:NT \l__beamerautolayout_weighted_bool
      {
        \int_zero:N \l__beamerautolayout_weight_sum_int
        \seq_map_inline:Nn \l__beamerautolayout_row_ids_seq
          {
            \__beamerautolayout_weight_for:nN {##1}
              \l__beamerautolayout_weight_int
            \int_add:Nn \l__beamerautolayout_weight_sum_int
              { \l__beamerautolayout_weight_int }
          }
      }

    \noindent\hbox to \linewidth
      {
        \int_zero:N \l__beamerautolayout_slot_index_int
        \seq_map_inline:Nn \l__beamerautolayout_row_ids_seq
          {
            \int_incr:N \l__beamerautolayout_slot_index_int
            \bool_if:NTF \l__beamerautolayout_weighted_bool
              {
                \__beamerautolayout_weight_for:nN {##1}
                  \l__beamerautolayout_weight_int
                \dim_set:Nn \l__beamerautolayout_share_dim
                  { \dim_eval:n
                      { \l__beamerautolayout_remaining_dim
                        * \l__beamerautolayout_weight_int
                        / \l__beamerautolayout_weight_sum_int } }
              }
              {
                \dim_set:Nn \l__beamerautolayout_share_dim
                  { \dim_eval:n
                      { \l__beamerautolayout_remaining_dim
                        / \l__beamerautolayout_row_slot_count_int } }
              }
            \dim_set:Nn \l__beamerautolayout_width_dim
              { \dim_eval:n
                  { \dim_use:c { g__beamerautolayout_minwidth_##1_dim }
                    + \l__beamerautolayout_share_dim } }
            \__beamerautolayout_render_block:nn
              {##1} { \dim_use:N \l__beamerautolayout_width_dim }
            \int_compare:nNnT
              { \l__beamerautolayout_slot_index_int }
              < { \l__beamerautolayout_row_slot_count_int }
              { \hspace{\l__beamerautolayout_gap_dim} }
          }
        \hfil
      }
  }

\cs_new_protected:Npn \__beamerautolayout_render:
  {
    \seq_set_split:NnV \l__beamerautolayout_rows_seq { + }
      \l__beamerautolayout_selected_layout_tl
    \int_zero:N \l__beamerautolayout_cursor_int
    \int_zero:N \l__beamerautolayout_row_index_int
    \seq_map_inline:Nn \l__beamerautolayout_rows_seq
      {
        \int_incr:N \l__beamerautolayout_row_index_int
        \int_set:Nn \l__beamerautolayout_row_count_int {##1}
        \seq_clear:N \l__beamerautolayout_row_ids_seq
        \int_step_inline:nn { \l__beamerautolayout_row_count_int }
          {
            \int_incr:N \l__beamerautolayout_cursor_int
            \int_compare:nNnT
              { \l__beamerautolayout_cursor_int }
              < { \g__beamerautolayout_block_count_int + 1 }
              {
                \seq_put_right:Nx \l__beamerautolayout_row_ids_seq
                  {
                    \seq_item:Nn \g__beamerautolayout_block_ids_seq
                      { \l__beamerautolayout_cursor_int }
                  }
              }
          }
        \seq_if_empty:NF \l__beamerautolayout_row_ids_seq
          { \__beamerautolayout_render_row: }
        \int_compare:nNnT
          { \l__beamerautolayout_row_index_int }
          < { \seq_count:N \l__beamerautolayout_rows_seq }
          { \par\vspace{\l__beamerautolayout_row_gap_dim} }
      }
  }

\cs_new_protected:Npn \__beamerautolayout_finish:
  {
    \int_compare:nNnTF { \g__beamerautolayout_block_count_int } = { 0 }
      {
        \PackageError{beamerautolayout}
          {autolayout~contains~no~autoblock}
          {Add~at~least~one~autoblock~before~the~end~of~the~environment.}
      }
      {
        \__beamerautolayout_select_layout:
        \__beamerautolayout_render:
      }
    \bool_set_false:N \l__beamerautolayout_active_bool
    \__beamerautolayout_clear_blocks:
  }

% --------------------------------------------------------------------------
% Public environments
% --------------------------------------------------------------------------
\NewDocumentEnvironment{autolayout}{ O{} }
  {
    \group_begin:
    \bool_if:NT \l__beamerautolayout_active_bool
      {
        \PackageError{beamerautolayout}
          {Nested~autolayout~environments~are~not~supported}
          {Close~the~outer~layout~before~starting~another~one.}
      }
    \bool_set_true:N \l__beamerautolayout_active_bool
    \int_gincr:N \g__beamerautolayout_instance_int
    \__beamerautolayout_clear_blocks:
    \__beamerautolayout_set_layout_defaults:
    \keys_set:nn { beamerautolayout / layout } {#1}
  }
  {
    \__beamerautolayout_finish:
    \group_end:
  }

\NewDocumentEnvironment{autoblock}{ O{} m +b }
  {
    \bool_if:NTF \l__beamerautolayout_active_bool
      {
        \group_begin:
        \__beamerautolayout_set_block_defaults:
        \keys_set:nn { beamerautolayout / block } {#1}
        \__beamerautolayout_store_block:nn {#2} {#3}
        \group_end:
      }
      {
        \PackageError{beamerautolayout}
          {autoblock~must~be~inside~autolayout}
          {Wrap~the~blocks~in~\string\begin{autolayout}...\string\end{autolayout}.}
      }
  }
  {}

